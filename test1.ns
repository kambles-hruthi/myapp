#------------------------------------------------------- 
# This ns script has been created by the nam editor.
# If you edit it manually, the nam editor might not
# be able to open it properly in the future.
#
# EDITING BY HAND IS AT YOUR OWN RISK!
#------------------------------------------------------- 
# Create a new simulator object.
set ns [new Simulator]
# Create a nam trace datafile.
set namfile [open /home/cp/test1.nam w]
$ns namtrace-all $namfile

# Create wired nodes.
set node(5) [$ns node]
## node(5) at 629.838257,575.911194
$node(5) set X_ 629.838257
$node(5) set Y_ 575.911194
$node(5) set Z_ 0.0
$node(5) color "black"

set node(4) [$ns node]
## node(4) at 454.222290,532.430725
$node(4) set X_ 454.222290
$node(4) set Y_ 532.430725
$node(4) set Z_ 0.0
$node(4) color "black"

set node(3) [$ns node]
## node(3) at 544.853699,546.265381
$node(3) set X_ 544.853699
$node(3) set Y_ 546.265381
$node(3) set Z_ 0.0
$node(3) color "black"

set node(2) [$ns node]
## node(2) at 548.524109,610.921448
$node(2) set X_ 548.524109
$node(2) set Y_ 610.921448
$node(2) set Z_ 0.0
$node(2) color "black"

set node(1) [$ns node]
## node(1) at 449.422485,616.003601
$node(1) set X_ 449.422485
$node(1) set Y_ 616.003601
$node(1) set Z_ 0.0
$node(1) color "black"


# Create links between nodes.
$ns simplex-link $node(5) $node(3) 1.000000Mb 20.000000ms DropTail
$ns simplex-link-op $node(5) $node(3) queuePos 0.5
$ns simplex-link-op $node(5) $node(3) color black
$ns simplex-link-op $node(5) $node(3) orient 199.2deg
# Set Queue Properties for link 5->3
[[$ns link $node(5) $node(3)] queue] set limit_ 20

$ns simplex-link $node(5) $node(2) 1.000000Mb 20.000000ms DropTail
$ns simplex-link-op $node(5) $node(2) queuePos 0.5
$ns simplex-link-op $node(5) $node(2) color black
$ns simplex-link-op $node(5) $node(2) orient 156.7deg
# Set Queue Properties for link 5->2
[[$ns link $node(5) $node(2)] queue] set limit_ 20

$ns simplex-link $node(4) $node(1) 1.000000Mb 20.000000ms DropTail
$ns simplex-link-op $node(4) $node(1) queuePos 0.5
$ns simplex-link-op $node(4) $node(1) color black
$ns simplex-link-op $node(4) $node(1) orient 93.3deg
# Set Queue Properties for link 4->1
[[$ns link $node(4) $node(1)] queue] set limit_ 20

$ns simplex-link $node(4) $node(3) 1.000000Mb 20.000000ms DropTail
$ns simplex-link-op $node(4) $node(3) queuePos 0.5
$ns simplex-link-op $node(4) $node(3) color black
$ns simplex-link-op $node(4) $node(3) orient 8.7deg
# Set Queue Properties for link 4->3
[[$ns link $node(4) $node(3)] queue] set limit_ 20

$ns simplex-link $node(3) $node(4) 1.000000Mb 20.000000ms DropTail
$ns simplex-link-op $node(3) $node(4) queuePos 0.5
$ns simplex-link-op $node(3) $node(4) color black
$ns simplex-link-op $node(3) $node(4) orient 188.7deg
# Set Queue Properties for link 3->4
[[$ns link $node(3) $node(4)] queue] set limit_ 20

$ns simplex-link $node(3) $node(1) 1.000000Mb 20.000000ms DropTail
$ns simplex-link-op $node(3) $node(1) queuePos 0.5
$ns simplex-link-op $node(3) $node(1) color black
$ns simplex-link-op $node(3) $node(1) orient 143.8deg
# Set Queue Properties for link 3->1
[[$ns link $node(3) $node(1)] queue] set limit_ 20

$ns simplex-link $node(3) $node(2) 1.000000Mb 20.000000ms DropTail
$ns simplex-link-op $node(3) $node(2) queuePos 0.5
$ns simplex-link-op $node(3) $node(2) color black
$ns simplex-link-op $node(3) $node(2) orient 86.8deg
# Set Queue Properties for link 3->2
[[$ns link $node(3) $node(2)] queue] set limit_ 20

$ns simplex-link $node(3) $node(5) 1.000000Mb 20.000000ms DropTail
$ns simplex-link-op $node(3) $node(5) queuePos 0.5
$ns simplex-link-op $node(3) $node(5) color black
$ns simplex-link-op $node(3) $node(5) orient 19.2deg
# Set Queue Properties for link 3->5
[[$ns link $node(3) $node(5)] queue] set limit_ 20

$ns simplex-link $node(2) $node(3) 1.000000Mb 20.000000ms DropTail
$ns simplex-link-op $node(2) $node(3) queuePos 0.5
$ns simplex-link-op $node(2) $node(3) color black
$ns simplex-link-op $node(2) $node(3) orient 266.8deg
# Set Queue Properties for link 2->3
[[$ns link $node(2) $node(3)] queue] set limit_ 20

$ns simplex-link $node(2) $node(5) 1.000000Mb 20.000000ms DropTail
$ns simplex-link-op $node(2) $node(5) queuePos 0.5
$ns simplex-link-op $node(2) $node(5) color black
$ns simplex-link-op $node(2) $node(5) orient 336.7deg
# Set Queue Properties for link 2->5
[[$ns link $node(2) $node(5)] queue] set limit_ 20

$ns simplex-link $node(2) $node(1) 1.000000Mb 20.000000ms DropTail
$ns simplex-link-op $node(2) $node(1) queuePos 0.5
$ns simplex-link-op $node(2) $node(1) color black
$ns simplex-link-op $node(2) $node(1) orient 177.1deg
# Set Queue Properties for link 2->1
[[$ns link $node(2) $node(1)] queue] set limit_ 20

$ns simplex-link $node(1) $node(4) 1.000000Mb 20.000000ms DropTail
$ns simplex-link-op $node(1) $node(4) queuePos 0.5
$ns simplex-link-op $node(1) $node(4) color black
$ns simplex-link-op $node(1) $node(4) orient 273.3deg
# Set Queue Properties for link 1->4
[[$ns link $node(1) $node(4)] queue] set limit_ 20

$ns simplex-link $node(1) $node(3) 1.000000Mb 20.000000ms DropTail
$ns simplex-link-op $node(1) $node(3) queuePos 0.5
$ns simplex-link-op $node(1) $node(3) color black
$ns simplex-link-op $node(1) $node(3) orient 323.8deg
# Set Queue Properties for link 1->3
[[$ns link $node(1) $node(3)] queue] set limit_ 20

$ns simplex-link $node(1) $node(2) 1.000000Mb 20.000000ms DropTail
$ns simplex-link-op $node(1) $node(2) queuePos 0.5
$ns simplex-link-op $node(1) $node(2) color black
$ns simplex-link-op $node(1) $node(2) orient 357.1deg
# Set Queue Properties for link 1->2
[[$ns link $node(1) $node(2)] queue] set limit_ 20

# Add Link Loss Models
set loss_model(1) [new ErrorModel/Periodic]
$ns lossmodel $loss_model(1) $node(3) $node(5)
$loss_model(1) unit pkt
$loss_model(1) set period_ 1.000000
$loss_model(1) set offset_ 0.000000
$loss_model(1) set burstlen_ 0.000000
$loss_model(1) drop-target [new Agent/Null]

# Create agents.
set agent(3) [new Agent/TCP]
$ns attach-agent $node(4) $agent(3)

# Create traffic sources and add them to the agent.
set traffic_source(1) [new Application/FTP]
$traffic_source(1) attach-agent $agent(3)
$traffic_source(1) set maxpkts_ 256
set agent(2) [new Agent/TCP]
$ns attach-agent $node(2) $agent(2)
set agent(1) [new Agent/TCP]
$ns attach-agent $node(1) $agent(1)

# Create traffic sources and add them to the agent.
set traffic_source(2) [new Application/FTP]
$traffic_source(2) attach-agent $agent(1)
$traffic_source(2) set maxpkts_ 256

# Connect agents.
# Run the simulation
proc finish {} {
	global ns namfile
	$ns flush-trace
	close $namfile
	exec nam -r 2000.000000us /home/cp/test1.nam &	
	exit 0
	}
$ns at 60.000000 "finish"
$ns run
